<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quick_card_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/quick_card_widget_background" android:contentDescription="@string/quick_card_widget_name">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_marginEnd="48dp" android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="12dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:paddingEnd="0dp">
    <FrameLayout android:id="@+id/quick_card_avatar" android:layout_width="80dp" android:layout_height="80dp" android:background="@drawable/quick_card_widget_avatar">
        <ImageView android:id="@+id/quick_card_photo" android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="centerCrop" android:visibility="gone" android:contentDescription="@null" />
        <TextView android:id="@+id/quick_card_initials" android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center" android:textSize="28sp" android:textColor="@color/quick_card_accent" android:visibility="gone" />
        <ImageView android:id="@+id/quick_card_person" android:layout_width="match_parent" android:layout_height="match_parent"
            android:padding="18dp" android:src="@drawable/ic_person" android:tint="@color/quick_card_accent" android:contentDescription="@null" />
    </FrameLayout>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginStart="12dp">
        <TextView android:id="@+id/quick_card_name" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:maxLines="2" android:ellipsize="end" android:textSize="22sp" android:textStyle="bold"
            android:textColor="@color/quick_card_text" android:text="@string/quick_card_widget_name" />
        <TextView android:id="@+id/quick_card_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:maxLines="2" android:ellipsize="end" android:textSize="16sp"
            android:textColor="@color/quick_card_secondary" android:text="@string/quick_card_widget_loading" />
    </LinearLayout>
    </LinearLayout>
    <ImageButton android:id="@+id/quick_card_menu" android:layout_width="48dp" android:layout_height="48dp"
        android:layout_gravity="end|center_vertical" android:padding="14dp" android:src="@drawable/quick_card_widget_menu_icon"
        android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/quick_card_widget_options"
        android:focusable="true" />
</FrameLayout>